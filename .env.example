# Copier vers .env (gitignored) et remplir.
#   copy .env.example .env

# RunPod — console : Settings → API Keys
#   runpodctl config --apiKey "<RUNPOD_API_KEY>"
RUNPOD_API_KEY=

# SSH du pod (Connect → SSH). Port souvent != 22.
RUNPOD_HOST=
RUNPOD_PORT=22
RUNPOD_SSH_KEY=
# Log d'entraînement à tailler depuis le notebook 08 (cellule log live).
RUNPOD_TRAIN_LOG=/workspace/train_vit_j_dp.log

# Optionnel — deja utilise par src/nlp/gemini_labeler.py
# GEMINI_API_KEY=
